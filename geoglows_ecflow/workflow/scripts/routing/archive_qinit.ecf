#!/bin/bash -l
%manual

    Archive Qinit files for the next forecast cycle

%end

%includeonce <ens.h>
%includeonce <ecflow_bash.h>

ls -al $ens_input
cd $ens_input
find . -type f -name "Qinit_${ens_basetime}.*" -print > Qinit_files

if [[ $(cat Qinit_files | wc -l) -ne $(find . -mindepth 1 -maxdepth 1 -type d | wc -l) ]];then
    echo "Fail, less Qinit files than expected"
    false
fi
tar cvzf $ens_fcdir/init_files_$ens_basetime.tar.gz -C $ens_input --files-from=Qinit_files
